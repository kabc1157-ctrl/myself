      "parameters": {
        "jsCode": "const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());\nconst cutoffDate = new Date(`${today}T00:00:00+09:00`);\ncutoffDate.setDate(cutoffDate.getDate() - 7);\nconst cutoff = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(cutoffDate);\nreturn items.filter(({ json }) => json.ai_feedback == null && json.reflection?.trim() && json.review_date >= cutoff && json.review_date <= today);"
      },
      "id": "routine-filter",
      "name": "최근 7일 미분석 회고만",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=다음 하루의 루틴 회고와 실행 수치만 근거로 한국어 피드백을 작성하세요. 기록에 없는 사실을 추측하지 말고, 하루 기록만으로 장기 행동 패턴을 단정하지 마세요. 따뜻하지만 구체적으로 작성하세요.\n\n[날짜]\n{{ $json.review_date }}\n\n[회고]\n{{ $json.reflection }}\n\n[달성률]\n{{ $json.total_count > 0 ? Math.round(($json.completion_count / $json.total_count) * 100) : 0 }}%\n\n[완료 개수 / 전체 개수]\n{{ $json.completion_count }} / {{ $json.total_count }}"
      },
